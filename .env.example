# LexiGuide Environment Configuration
# LexiGuide runs in zero-configuration Local Engine mode by default.
# Providing an API key enables real-time LLM inference for Gemini or OpenAI.

# Google Gemini API Key (Optional - activates Gemini LLM Provider)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional - alternative LLM Provider)
OPENAI_API_KEY=your_openai_api_key_here

# Active AI Provider: "local" (default, zero-dep), "gemini", or "openai"
AI_PROVIDER=local

# Security & Session Secret (used for demo session signing)
SESSION_SECRET=lexiguide_development_session_secret_change_in_production

# Max File Size (in bytes, default 10MB)
MAX_FILE_SIZE_BYTES=10485760
