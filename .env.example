# LexiGuide Environment Configuration
# LexiGuide runs in zero-configuration Local Engine mode by default.
# Providing an API key enables real-time LLM inference for Gemini or OpenAI.

# Neon Serverless PostgreSQL Database URL (Optional - activates persistent cloud database)
# Get a free connection string at https://neon.tech
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Gemini API Key (Optional - activates Gemini LLM Provider)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional - alternative LLM Provider)
OPENAI_API_KEY=your_openai_api_key_here

# Active AI Provider: "local" (default, zero-dep), "gemini", or "openai"
AI_PROVIDER=local

# Security & Session Secret (used for demo session signing)
SESSION_SECRET=lexiguide_development_session_secret_change_in_production

# Max File Size (in bytes, default 10MB)
MAX_FILE_SIZE_BYTES=10485760

# Firebase Web App Configuration (Optional - activates Firebase services)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

